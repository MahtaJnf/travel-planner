{
  "name": "client",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "client",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "client:build",
        "dev": true
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "root": "client"
      }
    }
  },
  "serve": {
    "executor": "@nx/next:server",
    "options": {
      "buildTarget": "client:build",
      "dev": true
    }
  }
}
