generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Favorite {
  id           Int      @id @default(autoincrement())
  user_id      String
  city_name    String
  country_code String
  created_at   DateTime @default(now())

  @@unique([user_id, city_name, country_code])
  @@map("favorites")
}

